<?xml version="1.0" encoding="utf-8"?>
<!--
  One reply notification: who replied, what they said, on which episode, and when.
  Deliberately flatter than item_comment — there is nothing to like, reply to or delete here,
  the row is a single target that opens the episode it belongs to.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/notification_item"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?android:attr/selectableItemBackground"
    android:orientation="horizontal"
    android:paddingStart="@dimen/comments_item_padding"
    android:paddingTop="10dp"
    android:paddingEnd="@dimen/comments_item_padding"
    android:paddingBottom="10dp">

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/notification_avatar"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/comments_avatar_background"
        android:scaleType="centerCrop" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/notification_actor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@android:color/white"
                android:textSize="14sp"
                android:textStyle="bold"
                tools:text="kasia" />

            <TextView
                android:id="@+id/notification_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textColor="#99FFFFFF"
                android:textSize="12sp"
                tools:text="4h" />

            <View
                android:id="@+id/notification_dot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/comments_badge_background" />
        </LinearLayout>

        <TextView
            android:id="@+id/notification_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="3"
            android:textColor="#E6FFFFFF"
            android:textSize="14sp"
            tools:text="More than we had in S1." />

        <TextView
            android:id="@+id/notification_parent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="#80FFFFFF"
            android:textSize="12sp"
            android:textStyle="italic"
            tools:text="You wrote: And more black out spice .." />

        <TextView
            android:id="@+id/notification_item_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#99FFFFFF"
            android:textSize="12sp"
            tools:text="Royal Blood &amp; Mafia Knight 2 – S01E41" />
    </LinearLayout>
</LinearLayout>
